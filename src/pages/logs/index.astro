---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const logs = (await getCollection('logs', ({ data }) => !data.draft)) as CollectionEntry<'logs'>[];
logs.sort((a: CollectionEntry<'logs'>, b: CollectionEntry<'logs'>) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="공부일지 – studyho">
  <h1 class="text-xl font-medium mb-6">공부일지</h1>
  <ul class="space-y-6">
    {logs.map((l) => (
      <li>
        <a class="text-lg hover:underline" href={`/logs/${l.slug}`}>{l.data.title || l.slug}</a>
        <p class="text-sm text-neutral-500 mt-1">{new Date(l.data.date).toISOString().slice(0, 10)} {l.data.mood && `· ${l.data.mood}`}</p>
      </li>
    ))}
  </ul>
</Layout>



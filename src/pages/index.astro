---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const columns = (await getCollection('columns', ({ data }) => !data.draft)) as CollectionEntry<'columns'>[];

// 최신 순 정렬
const sortedColumns = columns.sort(
  (a: CollectionEntry<'columns'>, b: CollectionEntry<'columns'>) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// 태그 집계
const allTags = columns.flatMap((c) => c.data.tags ?? []);
const tagCountMap = new Map<string, number>();

for (const t of allTags) {
  tagCountMap.set(t, (tagCountMap.get(t) ?? 0) + 1);
}

const topTags = Array.from(tagCountMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---


<Layout title="스터디호" description="공부와 생활을 기록한 글들을 모아둔 공간">
  {/* 페이지 헤더 */}
  <section class="mb-8 sm:mb-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.16em] text-neutral-400 mb-1">
          blog
        </p>
        <h1 class="text-xl sm:text-2xl font-semibold tracking-tight">
          studyho 칼럼
        </h1>
        <p class="mt-2 text-sm text-neutral-500">
          공부와 생활을 기록하고 공유하는 공간이에요.
        </p>
      </div>
      <div class="text-xs text-neutral-400">
        총{' '}
        <span class="font-medium text-neutral-700">
          {columns.length}
        </span>
        개의 글
      </div>
    </div>
  </section>

  {/* 인기 태그 */}
  {topTags.length ? (
    <section class="mb-8">
      <div class="mb-2 flex items-center justify-between">
        <h2 class="text-xs font-medium uppercase tracking-[0.16em] text-neutral-500">
          인기 태그
        </h2>
        <span class="text-[11px] text-neutral-400">
          자주 사용된 태그 순서예요.
        </span>
      </div>
      <div class="flex flex-wrap gap-2">
        {topTags.map(([tag, count]) => (
          <a
            href={`/columns?tag=${encodeURIComponent(tag)}`}
            class="inline-flex items-center gap-1 rounded-full border border-neutral-200 bg-white px-3 py-1 text-xs text-neutral-700 hover:bg-neutral-100"
          >
            <span>#{tag}</span>
            <span class="text-[10px] text-neutral-400">{count}</span>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  {/* 칼럼 리스트 — 그림자 제거, 플랫 스타일 */}
  <section>
    {sortedColumns.length ? (
      <div class="grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-2">
        {sortedColumns.map((c: CollectionEntry<'columns'>) => (
          <a
            href={`/columns/${c.slug}`}
            class="group flex flex-col rounded-xl border border-neutral-200 bg-white px-4 py-4 sm:px-5 sm:py-5 hover:bg-neutral-50 transition"
          >
            {/* 날짜 + 태그 */}
            <div class="flex items-center justify-between gap-2 text-[11px] text-neutral-400 mb-1.5">
              <span>{new Date(c.data.publishedAt).toISOString().slice(0, 10)}</span>
              {c.data.tags && c.data.tags.length > 0 && (
                <span class="inline-flex items-center gap-1 truncate max-w-[140px] justify-end">
                  <span class="h-1 w-1 rounded-full bg-neutral-300" />
                  <span class="truncate">
                    #{c.data.tags[0]}
                    {c.data.tags.length > 1 && (
                      <span class="text-neutral-400">
                        {' '}+{c.data.tags.length - 1}
                      </span>
                    )}
                  </span>
                </span>
              )}
            </div>

            {/* 제목 */}
            <h2 class="text-sm sm:text-base font-semibold tracking-tight text-neutral-900 group-hover:underline line-clamp-2">
              {c.data.title}
            </h2>

            {/* 요약 */}
            {c.data.summary && (
              <p class="mt-2 text-xs sm:text-sm text-neutral-600 line-clamp-3">
                {c.data.summary}
              </p>
            )}

            {/* 하단 */}
            <div class="mt-3 flex items-center justify-between text-[11px] text-neutral-400">
              <span>읽기</span>
              <span aria-hidden="true" class="group-hover:translate-x-[1px] transition">↗</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-neutral-500">아직 작성된 칼럼이 없습니다.</p>
    )}
  </section>
</Layout>

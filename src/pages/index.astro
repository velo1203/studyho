---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const columns = (await getCollection('columns', ({ data }) => !data.draft)) as CollectionEntry<'columns'>[];

// 최신 순 정렬
const sortedColumns = columns.sort(
  (a: CollectionEntry<'columns'>, b: CollectionEntry<'columns'>) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// 태그 집계
const allTags = columns.flatMap((c) => c.data.tags ?? []);
const tagCountMap = new Map<string, number>();

for (const t of allTags) {
  tagCountMap.set(t, (tagCountMap.get(t) ?? 0) + 1);
}

const topTags = Array.from(tagCountMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);

// 최신 칼럼 (Hero)
const latestColumn = sortedColumns[0];
---

<Layout title="studyho - 공부와 생활을 기록하는 공간" description="공부와 생활을 기록한 글들을 모아둔 공간">
  
  {/* Hero 섹션 */}
  <section class="mb-16 animate-fade-in">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full mb-6 animate-scale-in" style="background: var(--bg-tertiary); border: 1px solid var(--border-primary);">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--accent-primary)] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--accent-primary)]"></span>
        </span>
        <span class="text-xs font-medium" style="color: var(--text-secondary);">공부와 생활을 기록하는 공간</span>
      </div>
      
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight mb-6 animate-slide-in-left animate-delay-100" style="color: var(--text-primary);">
        안녕하세요, <br />
        <span class="relative inline-block">
          <span style="color: var(--accent-primary);">studyho</span>
          <span class="absolute bottom-0 left-0 w-full h-1" style="background: var(--accent-primary);"></span>
        </span>
        입니다
      </h1>
      
      <p class="text-lg sm:text-xl mb-8 leading-relaxed animate-slide-in-right animate-delay-200" style="color: var(--text-secondary);">
        국어, 영어, 수학을 중심으로 공부하며 배운 것들을<br class="hidden sm:inline" />
        기록하고 공유합니다.
      </p>
      
      <div class="flex items-center justify-center gap-4 animate-fade-in animate-delay-300">
        <a
          href="/columns"
          class="group px-6 py-3 rounded-xl font-semibold transition-smooth hover-lift"
          style="background: var(--accent-primary); color: var(--bg-primary);"
        >
          <span class="flex items-center gap-2">
            칼럼 둘러보기
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>
        </a>
        <a
          href="#recent"
          class="px-6 py-3 rounded-xl font-semibold transition-smooth hover-lift"
          style="background: var(--bg-tertiary); color: var(--text-primary); border: 1px solid var(--border-primary);"
        >
          최근 글 보기
        </a>
      </div>
    </div>
  </section>

  {/* 최신 글 하이라이트 */}
  {latestColumn && (
    <section class="mb-16 animate-fade-in animate-delay-200" id="latest">
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-5 h-5" style="color: var(--accent-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
          <h2 class="text-xl font-bold" style="color: var(--text-primary);">최신 칼럼</h2>
        </div>
        <p class="text-sm" style="color: var(--text-tertiary);">가장 최근에 작성된 글이에요.</p>
      </div>
      
      <a
        href={`/columns/${latestColumn.slug}`}
        class="group block p-8 rounded-2xl transition-smooth hover-lift"
        style="background: var(--bg-secondary); border: 1px solid var(--border-primary);"
      >
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="flex items-center gap-2 text-xs" style="color: var(--text-tertiary);">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {new Date(latestColumn.data.publishedAt).toISOString().slice(0, 10)}
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-medium" style="background: var(--accent-primary); color: var(--bg-primary);">NEW</span>
        </div>
        
        <h3 class="text-2xl sm:text-3xl font-bold mb-3 group-hover:text-[var(--accent-primary)] transition-colors" style="color: var(--text-primary);">
          {latestColumn.data.title}
        </h3>
        
        {latestColumn.data.summary && (
          <p class="text-base mb-4 leading-relaxed line-clamp-2" style="color: var(--text-secondary);">
            {latestColumn.data.summary}
          </p>
        )}
        
        {latestColumn.data.tags && latestColumn.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4">
            {latestColumn.data.tags.slice(0, 3).map((tag) => (
              <span class="px-3 py-1 rounded-full text-xs font-medium" style="background: var(--bg-tertiary); color: var(--text-secondary); border: 1px solid var(--border-primary);">
                #{tag}
              </span>
            ))}
          </div>
        )}
        
        <div class="flex items-center gap-2 text-sm font-medium group-hover:text-[var(--accent-primary)] transition-colors" style="color: var(--text-tertiary);">
          <span>자세히 읽기</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>
    </section>
  )}

  {/* 인기 태그 */}
  {topTags.length > 0 && (
    <section class="mb-16 animate-fade-in animate-delay-300">
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-5 h-5" style="color: var(--accent-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          <h2 class="text-xl font-bold" style="color: var(--text-primary);">인기 태그</h2>
        </div>
        <p class="text-sm" style="color: var(--text-tertiary);">자주 사용된 태그 순서예요.</p>
      </div>
      
      <div class="flex flex-wrap gap-3">
        {topTags.map(([tag, count], index) => (
          <a
            href={`/columns?tag=${encodeURIComponent(tag)}`}
            class="group px-4 py-2.5 rounded-xl transition-smooth hover-lift animate-scale-in"
            style={`background: var(--bg-secondary); border: 1px solid var(--border-primary); animation-delay: ${index * 0.05}s; opacity: 0;`}
          >
            <div class="flex items-center gap-2">
              <span class="text-sm font-semibold group-hover:text-[var(--accent-primary)] transition-colors" style="color: var(--text-primary);">
                #{tag}
              </span>
              <span class="px-2 py-0.5 rounded-full text-xs font-medium" style="background: var(--bg-tertiary); color: var(--text-tertiary);">
                {count}
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* 최근 칼럼 목록 */}
  <section class="animate-fade-in animate-delay-400" id="recent">
    <div class="mb-6">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" style="color: var(--accent-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <h2 class="text-xl font-bold" style="color: var(--text-primary);">모든 칼럼</h2>
        </div>
        <span class="text-sm font-medium px-3 py-1 rounded-full" style="background: var(--bg-tertiary); color: var(--text-secondary);">
          총 {columns.length}개
        </span>
      </div>
      <p class="text-sm" style="color: var(--text-tertiary);">최신 순으로 정렬되어 있어요.</p>
    </div>
    
    {sortedColumns.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {sortedColumns.map((c: CollectionEntry<'columns'>, index) => (
          <a
            href={`/columns/${c.slug}`}
            class="group p-6 rounded-xl transition-smooth hover-lift animate-fade-in"
            style={`background: var(--bg-secondary); border: 1px solid var(--border-primary); animation-delay: ${index * 0.05}s; opacity: 0;`}
          >
            {/* 날짜 + 태그 */}
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2 text-xs" style="color: var(--text-tertiary);">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {new Date(c.data.publishedAt).toISOString().slice(0, 10)}
              </div>
              {c.data.tags && c.data.tags.length > 0 && (
                <span class="text-xs font-medium px-2 py-0.5 rounded-full" style="background: var(--bg-tertiary); color: var(--text-tertiary);">
                  #{c.data.tags[0]}
                  {c.data.tags.length > 1 && ` +${c.data.tags.length - 1}`}
                </span>
              )}
            </div>

            {/* 제목 */}
            <h3 class="text-base sm:text-lg font-bold mb-2 line-clamp-2 group-hover:text-[var(--accent-primary)] transition-colors" style="color: var(--text-primary);">
              {c.data.title}
            </h3>

            {/* 요약 */}
            {c.data.summary && (
              <p class="text-sm mb-3 line-clamp-2 leading-relaxed" style="color: var(--text-secondary);">
                {c.data.summary}
              </p>
            )}

            {/* 하단 */}
            <div class="flex items-center gap-2 text-xs font-medium group-hover:text-[var(--accent-primary)] transition-colors" style="color: var(--text-tertiary);">
              <span>읽기</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 rounded-xl" style="background: var(--bg-secondary); border: 1px dashed var(--border-primary);">
        <svg class="w-16 h-16 mx-auto mb-4 opacity-50" style="color: var(--text-tertiary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p class="text-sm font-medium" style="color: var(--text-secondary);">아직 작성된 칼럼이 없습니다.</p>
      </div>
    )}
  </section>
</Layout>

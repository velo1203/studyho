---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
// removed StudyTracker/StudyCalendar

const posts = (await getCollection('posts', ({ data }) => !data.draft)) as CollectionEntry<'posts'>[];
const logs = (await getCollection('logs', ({ data }) => !data.draft)) as CollectionEntry<'logs'>[];
const reviews = (await getCollection('reviews', ({ data }) => !data.draft)) as CollectionEntry<'reviews'>[];

const recentPosts = posts
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 5);
const recentLogs = logs
  .sort((a: CollectionEntry<'logs'>, b: CollectionEntry<'logs'>) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const recentReviews = reviews
  .sort((a: CollectionEntry<'reviews'>, b: CollectionEntry<'reviews'>) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 5);

const featuredPost = recentPosts[0];

const recentItems = [
  ...recentPosts.map((p) => ({
    type: '칼럼' as const,
    title: p.data.title,
    href: `/posts/${p.slug}`,
    date: p.data.publishedAt,
    subtitle: p.data.summary || '',
  })),
  ...recentLogs.map((l) => ({
    type: '공부일지' as const,
    title: l.data.title || l.slug,
    href: `/logs/${l.slug}`,
    date: l.data.date,
    subtitle: l.data.mood ? `기분: ${l.data.mood}` : '',
  })),
  ...recentReviews.map((r) => ({
    type: '책 후기' as const,
    title: r.data.bookTitle,
    href: `/reviews/${r.slug}`,
    date: r.data.publishedAt,
    subtitle: `${r.data.author} · ★${r.data.rating}`,
  })),
]
  .sort((a, b) => a.date.getTime() - b.date.getTime())
  .reverse()
  .slice(0, 5);

const allTags = [
  ...posts.flatMap((p) => p.data.tags ?? []),
  ...logs.flatMap((l) => l.data.tags ?? []),
  ...reviews.flatMap((r) => r.data.tags ?? []),
];
const tagCountMap = new Map<string, number>();
for (const t of allTags) {
  tagCountMap.set(t, (tagCountMap.get(t) ?? 0) + 1);
}
const topTags = Array.from(tagCountMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<Layout title="studyho" description="국어 · 영어 · 수학 학습 기록">
  <section class="mb-10">
    <h1 class="text-2xl font-semibold tracking-tight">studyho</h1>
    <p class="text-neutral-600 mt-2">나의 고등학교 생활을 담은 공간</p>
    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <span class="text-neutral-600">과목별:</span>
      <a class="px-2 py-1 border border-black/10 hover:bg-black/5" href="/subjects/국어">국어</a>
      <a class="px-2 py-1 border border-black/10 hover:bg-black/5" href="/subjects/영어">영어</a>
      <a class="px-2 py-1 border border-black/10 hover:bg-black/5" href="/subjects/수학">수학</a>
      <a class="ml-auto px-3 py-1.5 rounded bg-black text-white hover:bg-black/90" href="/logs">공부일지 보기</a>
    </div>
  </section>

  <section class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2">
    <div class="rounded-lg border border-black/10 p-5">
      <h2 class="mb-3 text-lg font-medium">최근 업데이트</h2>
      {recentItems.length ? (
        <ul class="space-y-3">
          {recentItems.map((it) => (
            <li class="pb-3">
              <a class="hover:underline" href={it.href}>{it.title}</a>
              <p class="text-xs text-neutral-500 mt-1">{it.type} · {new Date(it.date).toISOString().slice(0, 10)}</p>
              {it.subtitle && <p class="text-sm text-neutral-600 mt-1">{it.subtitle}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-neutral-600">아직 업데이트가 없습니다.</p>
      )}
    </div>
    <div class="rounded-lg border border-black/10 p-5">
      <h2 class="mb-3 text-lg font-medium">추천 글</h2>
      {featuredPost ? (
        <div>
          <a class="text-base font-medium hover:underline" href={`/posts/${featuredPost.slug}`}>{featuredPost.data.title}</a>
          {featuredPost.data.summary && <p class="mt-2 text-sm text-neutral-600">{featuredPost.data.summary}</p>}
          <p class="mt-2 text-xs text-neutral-500">{new Date(featuredPost.data.publishedAt).toISOString().slice(0, 10)}</p>
        </div>
      ) : (
        <p class="text-sm text-neutral-600">아직 글이 없습니다.</p>
      )}
    </div>
  </section>

  {topTags.length ? (
    <section class="mb-12">
      <h2 class="mb-4 text-lg font-medium">인기 태그</h2>
      <ul class="flex flex-wrap gap-2">
        {topTags.map(([tag, count]) => (
          <li class="text-sm">
            <span class="inline-block px-2 py-1 border border-black/10">{tag} <span class="text-neutral-500">({count})</span></span>
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  <section class="grid grid-cols-1 gap-12 md:grid-cols-3">
    <div>
      <h2 class="mb-4 text-lg font-medium">최근 칼럼</h2>
      <ul class="space-y-3">
        {recentPosts.map((p: CollectionEntry<'posts'>) => (
          <li class="border-b border-black/10 pb-3">
            <a class="hover:underline" href={`/posts/${p.slug}`}>{p.data.title}</a>
            {p.data.summary && <p class="text-sm text-neutral-600 mt-1">{p.data.summary}</p>}
          </li>
        ))}
      </ul>
      <a class="mt-4 inline-block text-sm underline" href="/posts">모두 보기</a>
    </div>

    <div>
      <h2 class="mb-4 text-lg font-medium">최근 공부일지</h2>
      <ul class="space-y-3">
        {recentLogs.map((l: CollectionEntry<'logs'>) => (
          <li class="border-b border-black/10 pb-3">
            <a class="hover:underline" href={`/logs/${l.slug}`}>{l.data.title || l.slug}</a>
            <p class="text-sm text-neutral-600 mt-1">{new Date(l.data.date).toISOString().slice(0, 10)}</p>
          </li>
        ))}
      </ul>
      <a class="mt-4 inline-block text-sm underline" href="/logs">모두 보기</a>
    </div>

    <div>
      <h2 class="mb-4 text-lg font-medium">최근 책 후기</h2>
      <ul class="space-y-3">
        {recentReviews.map((r: CollectionEntry<'reviews'>) => (
          <li class="border-b border-black/10 pb-3">
            <a class="hover:underline" href={`/reviews/${r.slug}`}>{r.data.bookTitle}</a>
            <p class="text-sm text-neutral-600 mt-1">{r.data.author} · ★{r.data.rating}</p>
          </li>
        ))}
      </ul>
      <a class="mt-4 inline-block text-sm underline" href="/reviews">모두 보기</a>
    </div>
  </section>
</Layout>

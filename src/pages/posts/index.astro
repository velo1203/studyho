---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.publishedAt - +a.data.publishedAt
);
---

<Layout title="칼럼 – studyho">
  <h1 class="text-xl font-medium mb-6">칼럼</h1>
  <ul class="space-y-6">
    {posts.map((p) => (
      <li>
        <a class="text-lg hover:underline" href={`/posts/${p.slug}`}>{p.data.title}</a>
        {p.data.summary && <p class="text-neutral-600">{p.data.summary}</p>}
        <p class="text-sm text-neutral-500 mt-1">{new Date(p.data.publishedAt).toISOString().slice(0, 10)}</p>
      </li>
    ))}
  </ul>
</Layout>



---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const reviews = (await getCollection('reviews', ({ data }) => !data.draft)) as CollectionEntry<'reviews'>[];
reviews.sort((a: CollectionEntry<'reviews'>, b: CollectionEntry<'reviews'>) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout title="책 후기 – studyho">
  <h1 class="text-xl font-medium mb-6">책 후기</h1>
  <ul class="space-y-6">
    {reviews.map((r) => (
      <li>
        <a class="text-lg hover:underline" href={`/reviews/${r.slug}`}>{r.data.bookTitle}</a>
        <p class="text-sm text-neutral-500 mt-1">{r.data.author} · ★{r.data.rating} · {new Date(r.data.publishedAt).toISOString().slice(0, 10)}</p>
      </li>
    ))}
  </ul>
</Layout>



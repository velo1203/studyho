---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const subjects = ['국어', '영어', '수학'] as const;
  return subjects.map((subject) => ({ params: { subject } }));
}

const subject = Astro.params.subject as '국어' | '영어' | '수학';
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.subject === subject)) as CollectionEntry<'posts'>[];
const logs = (await getCollection('logs', ({ data }) => !data.draft && data.subject === subject)) as CollectionEntry<'logs'>[];
const reviews = (await getCollection('reviews', ({ data }) => !data.draft && data.subject === subject)) as CollectionEntry<'reviews'>[];

posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
logs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
reviews.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout title={`${subject} – studyho`} description={`${subject} 학습 기록`}>
  <h1 class="text-xl font-medium mb-6">{subject} 학습</h1>

  <section class="space-y-10">
    <div>
      <h2 class="mb-3 font-medium">칼럼 <span class="text-neutral-500 text-sm">({posts.length})</span></h2>
      {posts.length ? (
        <ul class="space-y-3">
          {posts.map((p) => (
            <li class="border-b border-black/10 pb-3">
              <a class="hover:underline" href={`/posts/${p.slug}`}>{p.data.title}</a>
              {p.data.summary && <p class="text-sm text-neutral-600 mt-1">{p.data.summary}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-neutral-500">아직 등록된 칼럼이 없습니다.</p>
      )}
    </div>

    <div>
      <h2 class="mb-3 font-medium">공부일지 <span class="text-neutral-500 text-sm">({logs.length})</span></h2>
      {logs.length ? (
        <ul class="space-y-3">
          {logs.map((l) => (
            <li class="border-b border-black/10 pb-3">
              <a class="hover:underline" href={`/logs/${l.slug}`}>{l.data.title || l.slug}</a>
              <p class="text-sm text-neutral-600 mt-1">{new Date(l.data.date).toISOString().slice(0, 10)}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-neutral-500">아직 등록된 공부일지가 없습니다.</p>
      )}
    </div>

    <div>
      <h2 class="mb-3 font-medium">책 후기 <span class="text-neutral-500 text-sm">({reviews.length})</span></h2>
      {reviews.length ? (
        <ul class="space-y-3">
          {reviews.map((r) => (
            <li class="border-b border-black/10 pb-3">
              <a class="hover:underline" href={`/reviews/${r.slug}`}>{r.data.bookTitle}</a>
              <p class="text-sm text-neutral-600 mt-1">{r.data.author} · ★{r.data.rating}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-neutral-500">아직 등록된 책 후기가 없습니다.</p>
      )}
    </div>
  </section>
</Layout>



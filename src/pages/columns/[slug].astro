---
import Layout from '@/layouts/Layout.astro';
import { getCollection, getEntryBySlug } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const all = await getCollection('columns', ({ data }) => !data.draft);
  return all.map((entry) => ({ params: { slug: entry.slug } }));
}

const slug = Astro.params.slug as string;
type ColumnEntry = CollectionEntry<'columns'>;
const maybeEntry = (await (getEntryBySlug as any)('columns', slug)) as ColumnEntry | undefined;

if (!maybeEntry) throw new Error(`Column not found: ${slug}`);

const entry = maybeEntry as ColumnEntry;
const { Content } = await entry.render();

// 관련 칼럼 찾기 (같은 태그를 가진 칼럼)
const allColumns = (await getCollection('columns', ({ data }) => !data.draft)) as CollectionEntry<'columns'>[];
const relatedColumns = allColumns
  .filter((c) => {
    if (c.slug === slug) return false;
    if (!entry.data.tags || !c.data.tags) return false;
    return entry.data.tags.some((tag) => c.data.tags?.includes(tag));
  })
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---
<Layout
  title={`${entry.data.title} – studyho`}
  description={entry.data.summary ?? '공부와 생활을 기록한 칼럼'}
  article={true}
>
  {/* 브레드크럼 네비게이션 */}
  <nav class="mb-8 animate-fade-in">
    <ol class="flex items-center gap-2 text-sm" style="color: var(--text-tertiary);">
      <li>
        <a href="/" class="hover:text-[var(--accent-primary)] transition-colors">홈</a>
      </li>
      <li>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li>
        <a href="/columns" class="hover:text-[var(--accent-primary)] transition-colors">칼럼</a>
      </li>
      <li>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li class="font-medium truncate" style="color: var(--text-secondary);">
        {entry.data.title}
      </li>
    </ol>
  </nav>

  <article>
    {/* 상단 헤더 영역 */}
    <header class="not-prose mb-12 pb-8 border-b animate-fade-in animate-delay-100" style="border-color: var(--border-primary);">
      <div class="mb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full mb-4 text-xs font-medium" style="background: var(--bg-tertiary); color: var(--text-tertiary); border: 1px solid var(--border-primary);">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          COLUMN
        </div>

        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-4 leading-tight" style="color: var(--text-primary);">
          {entry.data.title}
        </h1>

        {entry.data.summary && (
          <p class="text-base leading-relaxed" style="color: var(--text-secondary);">
            {entry.data.summary}
          </p>
        )}
      </div>

      {/* 메타 정보 */}
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <div class="flex items-center gap-2">
          <div class="flex items-center justify-center w-10 h-10 rounded-full" style="background: var(--bg-tertiary);">
            <svg class="w-5 h-5" style="color: var(--accent-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <div class="text-xs" style="color: var(--text-tertiary);">작성자</div>
            <div class="text-sm font-medium" style="color: var(--text-primary);">studyho</div>
          </div>
        </div>

        <div class="h-8 w-px" style="background: var(--border-primary);"></div>

        <div>
          <div class="flex items-center gap-1.5 text-xs mb-1" style="color: var(--text-tertiary);">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            발행일
          </div>
          <div class="text-sm font-medium" style="color: var(--text-primary);">
            {new Date(entry.data.publishedAt).toISOString().slice(0, 10)}
          </div>
        </div>

        {entry.data.updatedAt && (
          <>
            <div class="h-8 w-px" style="background: var(--border-primary);"></div>
            <div>
              <div class="flex items-center gap-1.5 text-xs mb-1" style="color: var(--text-tertiary);">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                수정일
              </div>
              <div class="text-sm font-medium" style="color: var(--text-primary);">
                {new Date(entry.data.updatedAt).toISOString().slice(0, 10)}
              </div>
            </div>
          </>
        )}
      </div>

      {/* 태그 */}
      {entry.data.tags?.length ? (
        <div class="mt-6">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-4 h-4" style="color: var(--accent-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            <span class="text-xs font-medium" style="color: var(--text-tertiary);">태그</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((t) => (
              <a
                href={`/columns?tag=${encodeURIComponent(t)}`}
                class="group px-3 py-1.5 rounded-lg text-sm font-medium transition-smooth hover-lift"
                style="background: var(--bg-tertiary); color: var(--text-secondary); border: 1px solid var(--border-primary);"
              >
                <span class="group-hover:text-[var(--accent-primary)]">#{t}</span>
              </a>
            ))}
          </div>
        </div>
      ) : null}
    </header>

    {/* 본문 */}
    <div
      class="
        prose prose-neutral max-w-none animate-fade-in animate-delay-200
        prose-lg
        prose-headings:tracking-tight prose-headings:font-bold prose-headings:scroll-mt-20
        prose-h1:text-3xl prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-3 prose-h2:border-b
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
        prose-p:leading-relaxed prose-p:my-5
        prose-a:font-medium prose-a:no-underline hover:prose-a:underline
        prose-strong:font-bold
        prose-img:rounded-xl prose-img:my-8 prose-img:shadow-lg
        prose-ul:my-5 prose-ol:my-5
        prose-li:my-2
        prose-blockquote:my-8 prose-blockquote:font-normal
        prose-code:font-semibold
        prose-pre:my-6 prose-pre:shadow-md
      "
    >
      <Content />
    </div>

    {/* 하단 네비게이션 */}
    <footer class="mt-12 pt-8 border-t" style="border-color: var(--border-primary);">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-12">
        <a
          href="/columns"
          class="group flex items-center gap-2 px-5 py-3 rounded-xl font-medium transition-smooth hover-lift"
          style="background: var(--bg-tertiary); color: var(--text-primary); border: 1px solid var(--border-primary);"
        >
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          칼럼 목록으로
        </a>

        <div class="flex items-center gap-3">
          <button
            onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
            class="group flex items-center gap-2 px-5 py-3 rounded-xl font-medium transition-smooth hover-lift"
            style="background: var(--accent-primary); color: var(--bg-primary);"
          >
            <svg class="w-4 h-4 transition-transform group-hover:-translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
            맨 위로
          </button>
        </div>
      </div>

      {/* 관련 칼럼 */}
      {relatedColumns.length > 0 && (
        <div class="animate-fade-in">
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5" style="color: var(--accent-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <h2 class="text-lg font-bold" style="color: var(--text-primary);">관련 칼럼</h2>
            </div>
            <p class="text-sm" style="color: var(--text-tertiary);">비슷한 주제의 글을 더 읽어보세요.</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {relatedColumns.map((c, index) => (
              <a
                href={`/columns/${c.slug}`}
                class="group p-5 rounded-xl transition-smooth hover-lift animate-scale-in"
                style={`background: var(--bg-secondary); border: 1px solid var(--border-primary); animation-delay: ${index * 0.1}s; opacity: 0;`}
              >
                <div class="flex items-center gap-1.5 text-xs mb-2" style="color: var(--text-tertiary);">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  {new Date(c.data.publishedAt).toISOString().slice(0, 10)}
                </div>
                
                <h3 class="text-base font-bold mb-2 line-clamp-2 group-hover:text-[var(--accent-primary)] transition-colors" style="color: var(--text-primary);">
                  {c.data.title}
                </h3>
                
                {c.data.summary && (
                  <p class="text-sm line-clamp-2 mb-3" style="color: var(--text-secondary);">
                    {c.data.summary}
                  </p>
                )}
                
                <div class="flex items-center gap-1 text-xs font-medium group-hover:text-[var(--accent-primary)] transition-colors" style="color: var(--text-tertiary);">
                  <span>읽기</span>
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </footer>
  </article>
</Layout>
